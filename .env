# ===== انسخ هذه المتغيرات إلى Render (Environment) — لا ترفع القيم الحقيقية إلى GitHub =====

# كلمة سر تختارها أنت (أي نص طويل)، وتكتبها نفسها في Meta عند إعداد الـ Webhook
VERIFY_TOKEN=اكتب_هنا_كلمة_طويلة_من_اختيارك

# رمز وصول الصفحة (Page Access Token) من Meta for Developers
PAGE_ACCESS_TOKEN=

# App Secret من: تطبيقك > App settings > Basic (إلزامي — بدونه يُرفض كل Webhook)
APP_SECRET=

# معرّف صفحة فيسبوك (Page ID) — رقم
PAGE_ID=

# اختياري: App ID لتطبيقك (يساعد في تمييز رسائل البوت عن ردود الموظفين في إنستغرام)
META_APP_ID=

# مفتاح Gemini من Google AI Studio
GEMINI_API_KEY=

# اختياري (القيم الافتراضية مناسبة)
GEMINI_MODEL=gemini-3.5-flash-lite
GRAPH_API_VERSION=v26.0

# تشغيل/إيقاف الميزات (true أو false)
ENABLE_MESSENGER=true
ENABLE_FB_COMMENTS=true
ENABLE_INSTAGRAM_DM=true
ENABLE_INSTAGRAM_COMMENTS=true
PUBLIC_COMMENT_REPLY=true
PRIVATE_REPLY_ON_COMMENT=true
REPLY_TO_COMMENT_REPLIES=false
BOT_DISCLOSURE_ENABLED=true

# حدود الأمان
MAX_REPLIES_PER_HOUR=200
HANDOFF_PAUSE_HOURS=12
HISTORY_MESSAGES=12

# للتجربة المحلية فقط — اتركه false على الخادم الحقيقي
ALLOW_UNSIGNED_WEBHOOKS=false
